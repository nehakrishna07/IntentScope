# Public, browser-visible inference service address; never put secrets in VITE_ values.
VITE_INFERENCE_API_URL=http://localhost:8000
# Python service environment (set these on the Python host)
MODEL_PATH=model/hingroberta_fold0_best
CORS_ORIGINS=http://localhost:8080,https://id-preview--7183550f-efb4-4b5d-bf66-e7609e8250d5.lovable.app

# Optional n8n downstream automation (server-only; never expose secrets in VITE_ variables)
N8N_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_AUTH_HEADER=X-IntentScope-Secret
N8N_TIMEOUT_SECONDS=5
